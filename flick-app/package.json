{
  "name": "flick",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:init:local": "wrangler d1 execute flick-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute flick-db --remote --file=./schema.sql",
    "pages:dev": "wrangler pages dev -- npm run dev",
    "deploy": "vite build && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.1",
    "wrangler": "^3.78.0"
  }
}
